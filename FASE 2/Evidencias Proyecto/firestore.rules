rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // La cuenta del portal se identifica por el correo username@academy7.cl.
    // Por ejemplo, asilva accede a teachers/asilva.
    match /teachers/{teacherId}/courses/{courseId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == teacherId + '@academy7.cl';
    }

    match /teachers/{teacherId}/messages/{messageId} {
      allow read, write: if request.auth != null
        && request.auth.token.email == teacherId + '@academy7.cl';
    }

    // Denegar todo lo demás por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
